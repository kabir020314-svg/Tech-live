# Tech Live Backend Environment Variables (NEVER commit real secrets)
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://techlive_user:CHANGE_ME@postgres:5432/techlive
JWT_SECRET=CHANGE_ME_256_BIT_SECRET
ENCRYPTION_KEY_HEX=CHANGE_ME_64_HEX_CHARS_FOR_AES_256_GCM
CORS_ORIGIN=https://admin.techlive.example

# Official Live Streaming OAuth Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://api.techlive.example/api/v1/oauth/youtube/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.techlive.example/api/v1/oauth/facebook/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_LIVE_API_ENABLED=false

# Object Storage (S3 / Cloudflare R2 / GCS) for 1 GB Prerecorded Videos
STORAGE_BUCKET=techlive-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment Gateway & Mobile Banking Verification Webhooks
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_WEBHOOK_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=

# Initial Super Admin Bootstrap Email
BOOTSTRAP_ADMIN_EMAIL=kabir020314@gmail.com
